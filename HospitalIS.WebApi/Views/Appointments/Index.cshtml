@model IEnumerable<HospitalIS.Application.DTOs.Appointments.AppointmentDto>
@{
    ViewData["Title"] = "Записи на приём";
}

<h2><svg class="ic"><use href="#i-list" /></svg> Записи на приём</h2>
<p><a href="/Appointments/Create" class="btn btn-add"><svg class="ic"><use href="#i-plus" /></svg> Новая запись</a></p>

@if (!Model.Any())
{
    <div class="empty">Записей пока нет. Создайте первую.</div>
}
else
{
    <div class="table-wrap">
        <table>
            <thead><tr><th>ID</th><th>Пациент</th><th>Врач</th><th>Дата и время</th><th>Статус</th><th>Создана</th><th>Действия</th></tr></thead>
            <tbody>
                @foreach (var a in Model)
                {
                    var st = (AppointmentStatus)a.Status;
                    <tr>
                        <td>@a.Id</td>
                        <td><strong>@a.PatientName</strong></td>
                        <td>@a.DoctorName</td>
                        <td>@a.AppointmentDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                        <td><span class="status status-@EnumDisplay.Css(st)">@EnumDisplay.Text(st)</span></td>
                        <td>@a.CreatedAt.ToString("dd.MM.yyyy")</td>
                        <td>
                            <span class="row-actions">
                                <a href="/Appointments/Details/@a.Id" class="btn btn-view btn-sm" title="Открыть"><svg class="ic"><use href="#i-eye" /></svg></a>
                                <a href="/Appointments/DeleteConfirm/@a.Id" class="btn btn-del btn-sm" title="Удалить"><svg class="ic"><use href="#i-trash" /></svg></a>
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}