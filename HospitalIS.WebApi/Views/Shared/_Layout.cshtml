@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var toastMsg = TempData["Success"] as string ?? TempData["Error"] as string;
    var toastKind = TempData["Error"] != null ? "error" : "success";
    var undoPayload = TempData["UndoDoctors"] as string ?? TempData["UndoPatients"] as string ?? TempData["UndoSpecializations"] as string;
    var undoAction = TempData["UndoDoctors"] != null ? "/Doctors/Restore"
        : TempData["UndoPatients"] != null ? "/Patients/Restore"
        : "/Specializations/Restore";
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — ИС «Больница»</title>
    <link rel="stylesheet" href="/css/site.css" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='6' fill='%230f7f8b'/%3E%3Cpath d='M12 6v12M6 12h12' stroke='white' stroke-width='3' stroke-linecap='round'/%3E%3C/svg%3E" />
</head>
<body data-page="@ctrl" data-role="@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "")">
    <svg style="display:none" xmlns="http://www.w3.org/2000/svg">
        <symbol id="i-cross" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></symbol>
        <symbol id="i-eye" viewBox="0 0 24 24"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z" /><circle cx="12" cy="12" r="3" /></symbol>
        <symbol id="i-pencil" viewBox="0 0 24 24"><path d="M17 3l4 4L8 20l-5 1 1-5L17 3z" /></symbol>
        <symbol id="i-trash" viewBox="0 0 24 24"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14M10 11v6M14 11v6" /></symbol>
        <symbol id="i-plus" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></symbol>
        <symbol id="i-save" viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" /><path d="M17 21v-8H7v8M7 3v5h8" /></symbol>
        <symbol id="i-back" viewBox="0 0 24 24"><path d="M19 12H5M12 19l-7-7 7-7" /></symbol>
        <symbol id="i-users" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" /></symbol>
        <symbol id="i-doctor" viewBox="0 0 24 24"><circle cx="12" cy="8" r="4" /><path d="M4 21v-1a8 8 0 0 1 16 0v1M12 12v4M10 14h4" /></symbol>
        <symbol id="i-list" viewBox="0 0 24 24"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" /></symbol>
        <symbol id="i-book" viewBox="0 0 24 24"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V2H6.5A2.5 2.5 0 0 0 4 4.5v15z" /><path d="M4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5" /></symbol>
        <symbol id="i-chart" viewBox="0 0 24 24"><path d="M3 3v18h18M8 17V9M13 17V5M18 17v-7" /></symbol>
        <symbol id="i-warn" viewBox="0 0 24 24"><path d="M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" /><path d="M12 9v4M12 17h.01" /></symbol>
        <symbol id="i-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" /><path d="M21 21l-4.35-4.35" /></symbol>
        <symbol id="i-bolt" viewBox="0 0 24 24"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" /></symbol>
        <symbol id="i-db" viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3" /><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" /></symbol>
    </svg>

    <div id="aurora"></div>
    <div id="grain"></div>

    <header class="masthead">
        <div class="brand">
            <span class="brand-mark"><svg class="ic" style="width:26px;height:26px"><use href="#i-cross" /></svg></span>
            <h1>Информационная система «Больница»</h1>
        </div>
        <p>Учёт врачей, пациентов и специальностей · слоистая архитектура · ASP.NET Core MVC</p>
        <span class="date-chip"><span class="pulse"></span> Система активна · @DateTime.Now.ToString("dd.MM.yyyy")</span>
    </header>

    <nav class="nav" id="nav">
        <a href="/" class="@(ctrl == "Home" ? "active" : "")">Главная</a>
        <a href="/Doctors" class="@(ctrl == "Doctors" ? "active" : "")">Врачи</a>
        <a href="/Patients" class="@(ctrl == "Patients" ? "active" : "")">Пациенты</a>
        <a href="/Appointments" class="@(ctrl == "Appointments" ? "active" : "")">Записи</a>
        <a href="/Consultations" class="@(ctrl == "Consultations" ? "active" : "")">Консультации</a>
        <a href="/Dispensary" class="@(ctrl == "Dispensary" ? "active" : "")">Диспансер</a>
        <a href="/Diagnoses" class="@(ctrl == "Diagnoses" ? "active" : "")">Диагнозы</a>
        <a href="/Specializations" class="@(ctrl == "Specializations" ? "active" : "")">Специальности</a>
        @if (User.IsPatient())
        {
            <a href="/Patients/Profile">Мой профиль</a>
        }
        @if (User.Identity?.IsAuthenticated == true)
        {
            var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
            var roleRu = role switch { "Administrator" => "Администратор", "Doctor" => "Врач", "Patient" => "Пациент", _ => role };
            var fullName = User.FindFirst("FullName")?.Value ?? User.Identity.Name;
            <span class="nav-user">👤 @fullName <em>@roleRu</em></span>
            <form method="post" asp-controller="Account" asp-action="Logout" class="nav-logout">
                <button type="submit">Выход</button>
            </form>
        }
        else
        {
            <a href="/Account/Login" class="@(ctrl == "Account" ? "active" : "")">Вход</a>
            <a href="/Account/Register" class="nav-cta">Регистрация</a>
        }
    </nav>

    <main class="container">
        <section class="panel">
            @RenderBody()
        </section>
    </main>

    <footer>Курсовой проект · HospitalIS · @DateTime.Now.Year · .NET 10 · EF Core · SQLite</footer>

    <div id="scrim"></div>
    <aside id="drawer" aria-hidden="true" aria-label="Карточка записи">
        <header>
            <h3 id="drawerTitle">Карточка</h3>
            <button id="drawerClose" type="button" aria-label="Закрыть">✕</button>
        </header>
        <dl id="drawerBody"></dl>
        <footer>
            <a id="drawerEdit" href="#" class="btn btn-edit btn-sm"><svg class="ic"><use href="#i-pencil" /></svg> Изменить</a>
            <a id="drawerDelete" href="#" class="btn btn-del btn-sm"><svg class="ic"><use href="#i-trash" /></svg> Удалить</a>
            <a id="drawerFull" href="#" class="btn btn-ghost btn-sm">Открыть страницу</a>
        </footer>
    </aside>

    <div id="modalScrim"></div>
    <div id="confirmModal" role="dialog" aria-modal="true" aria-labelledby="confirmTitle">
        <div class="modal-card">
            <h3 id="confirmTitle"><svg class="ic"><use href="#i-warn" /></svg> Подтверждение</h3>
            <p id="confirmText"></p>
            <form id="confirmForm" method="post">
                <div id="confirmFields"></div>
                <div class="modal-actions">
                    <button type="button" class="btn btn-ghost" data-close>Отмена</button>
                    <button type="submit" class="btn btn-del"><svg class="ic"><use href="#i-trash" /></svg> Удалить</button>
                </div>
            </form>
        </div>
    </div>

    <div id="toast" class="@toastKind" data-msg="@toastMsg">
        <span>@toastMsg</span>
        @if (undoPayload != null)
        {
            <form method="post" action="@undoAction" style="margin:0">
                <input type="hidden" name="payload" value="@undoPayload" />
                <button type="submit" class="btn-undo">Отменить</button>
            </form>
        }
    </div>

    <script src="/js/site.js"></script>
</body>
</html>