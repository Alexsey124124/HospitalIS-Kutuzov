@model IEnumerable<HospitalIS.Application.DTOs.Specializations.SpecializationDto>
@{
    ViewData["Title"] = "Специальности";
}

<h2>Список специальностей</h2>
<p><a href="/Specializations/Create" class="btn btn-add">＋ Добавить специальность</a></p>

<div class="toolbar" data-table-tools data-target="#specTable">
    <input type="search" class="tool-search" placeholder="Поиск по названию…" />
    <select class="tool-sort">
        <option value="">Сортировка…</option>
        <option value="1:asc">Название А→Я</option>
        <option value="1:desc">Название Я→А</option>
    </select>
    <button type="button" class="btn btn-ghost btn-sm tool-reset">Сброс</button>
    <span class="badge tool-count"></span>
</div>

@if (!Model.Any())
{
    <div class="empty">Специальности не найдены.</div>
}
else
{
    <table id="specTable">
        <thead><tr><th>ID</th><th>Название</th><th>Описание</th><th>Действия</th></tr></thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.Id</td>
                    <td>@s.Name</td>
                    <td>@s.Description</td>
                    <td>
                        <a href="/Specializations/Details/@s.Id" class="btn btn-view btn-sm">👁</a>
                        <a href="/Specializations/Edit/@s.Id" class="btn btn-edit btn-sm">✏</a>
                        <a href="/Specializations/DeleteConfirm/@s.Id" class="btn btn-del btn-sm">🗑</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}