@model HospitalIS.Application.DTOs.Diagnoses.DiagnosisDto
@{
    ViewData["Title"] = "Диагноз";
}

<h2><svg class="ic"><use href="#i-book" /></svg> @Model.MKBCode — @Model.Name</h2>
<div class="table-wrap kv">
    <table>
        <tr><th>ID</th><td>@Model.Id</td></tr>
        <tr><th>Код МКБ-10</th><td>@Model.MKBCode</td></tr>
        <tr><th>Название</th><td>@Model.Name</td></tr>
        <tr><th>Категория</th><td>@Model.Category</td></tr>
        <tr><th>Описание</th><td>@Model.Description</td></tr>
        <tr><th>Использований</th><td>@Model.UsageCount (консультации + диспансер)</td></tr>
    </table>
</div>
<div class="form-actions">
    @if (User.IsAdmin())
    {
        <a href="/Diagnoses/Edit/@Model.Id" class="btn btn-edit"><svg class="ic"><use href="#i-pencil" /></svg> Изменить</a>
    }
    <a href="/Diagnoses" class="btn btn-ghost"><svg class="ic"><use href="#i-back" /></svg> Назад</a>
</div>