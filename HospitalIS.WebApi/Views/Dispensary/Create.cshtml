@model HospitalIS.Application.DTOs.Dispensary.CreateDispensaryRecordDto
@{
    ViewData["Title"] = "Постановка на учёт";
    var patients = (IEnumerable<HospitalIS.Application.DTOs.Dispensary.IdNameOption>)ViewBag.Patients;
    var doctors = (IEnumerable<HospitalIS.Application.DTOs.Dispensary.IdNameOption>)ViewBag.Doctors;
    var diagnoses = (IEnumerable<HospitalIS.Application.DTOs.Dispensary.IdNameOption>)ViewBag.Diagnoses;
}

<h2><svg class="ic"><use href="#i-plus" /></svg> Поставить пациента на учёт</h2>
<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="form-grid">
        @if (User.IsDoctor())
        {
            <input type="hidden" asp-for="DoctorId" value="@User.UserId()" />
            <div class="field span2"><label>Врач</label><input value="@User.FindFirst("FullName")?.Value" disabled /></div>
        }
        else
        {
            <div class="field span2">
                <label asp-for="DoctorId">Врач</label>
                <select asp-for="DoctorId">
                    <option value="0">— выберите —</option>
                    @foreach (var d in doctors)
                    {
                        <option value="@d.Id">@d.Label</option>
                    }
                </select>
                <span asp-validation-for="DoctorId" class="text-danger"></span>
            </div>
        }
        <div class="field span2">
            <label asp-for="PatientId">Пациент</label>
            <select asp-for="PatientId">
                <option value="0">— выберите —</option>
                @foreach (var p in patients)
                {
                    <option value="@p.Id">@p.Label</option>
                }
            </select>
            <span asp-validation-for="PatientId" class="text-danger"></span>
        </div>
        <div class="field span2">
            <label asp-for="DiagnosisId">Диагноз (МКБ-10)</label>
            <select asp-for="DiagnosisId">
                <option value="0">— выберите —</option>
                @foreach (var d in diagnoses)
                {
                    <option value="@d.Id">@d.Label</option>
                }
            </select>
            <span asp-validation-for="DiagnosisId" class="text-danger"></span>
        </div>
        <div class="field"><label asp-for="StartDate">Дата постановки</label><input asp-for="StartDate" type="date" /></div>
        <div class="field"><label asp-for="NextVisitDate">Следующий визит</label><input asp-for="NextVisitDate" type="date" /></div>
        <div class="field span2">
            <label asp-for="Status">Статус наблюдения</label>
            <select asp-for="Status" asp-items="ViewBag.Statuses"></select>
        </div>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-add"><svg class="ic"><use href="#i-save" /></svg> Поставить на учёт</button>
        <a href="/Dispensary" class="btn btn-ghost"><svg class="ic"><use href="#i-back" /></svg> Отмена</a>
    </div>
</form>