@model HospitalIS.Application.DTOs.Consultations.ConsultationDto
@{
    ViewData["Title"] = "Консультация"; var st = (ConsultationStatus)Model.Status;
}

<h2><svg class="ic"><use href="#i-doctor" /></svg> Консультация №@Model.Id</h2>
<div class="table-wrap kv">
    <table>
        <tr><th>Пациент</th><td>@Model.PatientName</td></tr>
        <tr><th>Врач</th><td>@Model.DoctorName</td></tr>
        <tr><th>Начало</th><td>@Model.StartDateTime.ToString("dd.MM.yyyy HH:mm")</td></tr>
        <tr><th>Диагноз</th><td>@Model.DiagnosisName</td></tr>
        <tr><th>Статус</th><td><span class="status status-@EnumDisplay.Css(st)">@EnumDisplay.Text(st)</span></td></tr>
        <tr><th>Лечение</th><td>@(string.IsNullOrWhiteSpace(Model.TreatmentText) ? "не назначено" : Model.TreatmentText)</td></tr>
    </table>
</div>
<div class="form-actions">
    @if (!User.IsPatient())
    {
        <a href="/Consultations/Edit/@Model.Id" class="btn btn-edit"><svg class="ic"><use href="#i-pencil" /></svg> Изменить</a>
    }
    <a href="/Consultations" class="btn btn-ghost"><svg class="ic"><use href="#i-back" /></svg> Назад</a>
</div>