@model IEnumerable<HospitalIS.Application.DTOs.Consultations.ConsultationDto>
@{
    ViewData["Title"] = "Консультации";
}

<h2><svg class="ic"><use href="#i-doctor" /></svg> Консультации</h2>
@if (User.IsDoctor() || User.IsAdmin())
{
    <p><a href="/Consultations/Create" class="btn btn-add"><svg class="ic"><use href="#i-plus" /></svg> Провести консультацию</a></p>
}

@if (!Model.Any())
{
    <div class="empty">Консультаций пока нет.</div>
}
else
{
    <div class="table-wrap">
        <table>
            <thead><tr><th>ID</th><th>Пациент</th><th>Врач</th><th>Начало</th><th>Диагноз</th><th>Статус</th><th>Медзапись</th><th>Действия</th></tr></thead>
            <tbody>
                @foreach (var c in Model)
                {
                    var st = (ConsultationStatus)c.Status;
                    <tr>
                        <td>@c.Id</td>
                        <td><strong>@c.PatientName</strong></td>
                        <td>@c.DoctorName</td>
                        <td>@c.StartDateTime.ToString("dd.MM.yyyy HH:mm")</td>
                        <td>@c.DiagnosisName</td>
                        <td><span class="status status-@EnumDisplay.Css(st)">@EnumDisplay.Text(st)</span></td>
                        <td>@(c.HasRecord ? " есть" : "— нет")</td>
                        <td>
                            <span class="row-actions">
                                <a href="/Consultations/Details/@c.Id" class="btn btn-view btn-sm">Открыть</a>
                                @if (!User.IsPatient())
                                {
                                    <a href="/Consultations/Edit/@c.Id" class="btn btn-edit btn-sm">Изменить</a>
                                }
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}