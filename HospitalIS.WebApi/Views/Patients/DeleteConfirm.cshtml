@model HospitalIS.Application.DTOs.Patients.PatientDto
@{
    ViewData["Title"] = "Удаление пациента";
}

<h2>Удалить пациента?</h2>
<div class="danger-card">
    <p><strong>@Model.LastName @Model.FirstName @Model.MiddleName</strong></p>
    <p>Полис: @Model.PolicyNumber · Дата рождения: @Model.BirthDate.ToString("dd.MM.yyyy")</p>
</div>
<form method="post">
    <button type="submit" class="btn btn-del"> Да, удалить</button>
    <a href="/Patients" class="btn btn-ghost">Отмена</a>
</form>