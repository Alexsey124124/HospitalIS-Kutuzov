@model HospitalIS.Application.DTOs.Patients.PatientDto
@{
    ViewData["Title"] = "Пациент";
}

<h2>Информация о пациенте</h2>
<table class="kv">
    <tr><th>ID</th><td>@Model.Id</td></tr>
    <tr><th>Фамилия</th><td>@Model.LastName</td></tr>
    <tr><th>Имя</th><td>@Model.FirstName</td></tr>
    <tr><th>Отчество</th><td>@Model.MiddleName</td></tr>
    <tr><th>Дата рождения</th><td>@Model.BirthDate.ToString("dd.MM.yyyy")</td></tr>
    <tr><th>Полис</th><td>@Model.PolicyNumber</td></tr>
    <tr><th>Телефон</th><td>@Model.Phone</td></tr>
    <tr><th>Email</th><td>@Model.Email</td></tr>
</table>
<p><a href="/Patients/Edit/@Model.Id" class="btn btn-edit">✏ Редактировать</a><a href="/Patients" class="btn btn-ghost">← Назад</a></p>